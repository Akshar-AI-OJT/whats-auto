# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000


# Better Auth: signing secret for sessions and cookie cache.
# Must be at least 32 characters. Must match across api and web.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

# Google OAuth 
# Leave unset to disable Google sign-in. To enable, register an
# OAuth app at https://console.cloud.google.com/ and paste the
# values here. See README "Google OAuth setup" for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Meta WhatsApp Cloud API (platform — one app for the whole SaaS)
# Webhook URL: https://<host>/api/v1/webhooks/whatsapp
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=

  JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_PGBOSS_SCHEMA=pgboss

#--------------------------------------------------------------------
# Platform Razorpay billing
# Webhook URL: https://<host>/api/v1/webhooks/billing/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

#--------------------------------------------------------------------
# Object storage (Adonis Drive)
# Contact import CSVs: organizations/{organizationId}/imports/contacts/{name}.csv
# DRIVE_DISK=fs stores under apps/backend/storage (tmp/storage in tests).
# DRIVE_DISK=s3 uses the S3-compatible bucket below.
#--------------------------------------------------------------------
DRIVE_DISK=fs
# OBJECT_STORAGE_DRIVER=s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
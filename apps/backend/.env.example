# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS / frontend origin (single URL, no trailing slash)
# Local: Next.js origin.
# Contabo (cross-origin): https://ottobot.codecolonies.com
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000


# Better Auth: signing secret for sessions and cookie cache.
# Must be at least 32 characters. Must match across api and web.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the Better Auth mount (Google OAuth redirect base).
# Contabo (cross-origin): https://api.ottobot.codecolonies.com
# Google Console redirect: {BETTER_AUTH_URL}/api/auth/callback/google
# Do not enable Partitioned cookies in auth.ts for this topology (breaks OAuth state).
BETTER_AUTH_URL=http://localhost:3333

JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

# Google OAuth 
# Leave unset to disable Google sign-in. To enable, register an
# OAuth app at https://console.cloud.google.com/ and paste the
# values here. See README "Google OAuth setup" for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Meta WhatsApp Cloud API (platform — one app for the whole SaaS)
# Webhook URL: https://<host>/api/v1/webhooks/whatsapp
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=

# Smoke-test only. When a mapped shopenup_* template is missing or not approved,
# send this approved name instead. Unset after real templates are approved, then
# you can delete hello_world. Preferred names still win while this is set.
# INTEGRATION_COMMERCE_TEMPLATE_FALLBACK=hello_world

# All jobs (outbound, campaigns, media, billing, AI) run on BullMQ via Redis.
JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_BULLMQ_PREFIX=wa:bullmq
REDIS_URL=redis://127.0.0.1:6379
# Plan-aware AI / campaign anti-abuse hard caps (optional; defaults applied in code)
AI_CONV_RATE_LIMIT_HARD_CAP=120
CAMPAIGN_DISPATCH_RATE_HARD_CAP=60
# Required at runtime only when platform_ai_configs.isEnabled is true for that provider
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

#--------------------------------------------------------------------
# Platform Razorpay billing
# Webhook URL: https://<host>/api/v1/webhooks/billing/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

#--------------------------------------------------------------------
# Object storage — pick one mode (OBJECT_STORAGE_DRIVER must match DRIVE_DISK)
#
# Contabo physical disk (recommended for Contabo VPS):
#   OBJECT_STORAGE_DRIVER=fs
#   DRIVE_DISK=fs
#   MEDIA_LOCAL_ROOT=./media
#   MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/media
#   OUTBOUND_MEDIA_ALLOWED_HOSTS=api.yourdomain.com
#
# S3-compatible (Contabo Object Storage / AWS / R2):
#   OBJECT_STORAGE_DRIVER=s3
#   DRIVE_DISK=s3
#   S3_* + MEDIA_PUBLIC_BASE_URL for the public CDN/base
#--------------------------------------------------------------------
OBJECT_STORAGE_DRIVER=fs
DRIVE_DISK=fs
MEDIA_LOCAL_ROOT=./media
MEDIA_PUBLIC_BASE_URL=
OUTBOUND_MEDIA_ALLOWED_HOSTS=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=default
# S3_BUCKET=
# S3_ENDPOINT=https://eu2.contabostorage.com
# S3_FORCE_PATH_STYLE=true
# Local dev: smtp + Mailpit (localhost:1025). Production on Railway: resend (SMTP ports blocked).
MAIL_MAILER=smtp
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Required when MAIL_MAILER=brevo
BREVO_API=
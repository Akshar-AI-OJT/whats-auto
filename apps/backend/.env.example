# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS / frontend origin (single URL, no trailing slash)
# Local: Next.js origin.
# Contabo (cross-origin app. + api.): https://app.yourdomain.com
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000


# Better Auth: signing secret for sessions and cookie cache.
# Must be at least 32 characters. Must match across api and web.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the Better Auth mount (Google OAuth redirect base).
# Contabo (cross-origin): https://api.yourdomain.com
# Google Console redirect: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3333

JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

# Google OAuth 
# Leave unset to disable Google sign-in. To enable, register an
# OAuth app at https://console.cloud.google.com/ and paste the
# values here. See README "Google OAuth setup" for details.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Meta WhatsApp Cloud API (platform — one app for the whole SaaS)
# Webhook URL: https://<host>/api/v1/webhooks/whatsapp
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=

# All jobs (outbound, campaigns, media, billing, AI) run on BullMQ via Redis.
JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_BULLMQ_PREFIX=wa:bullmq
REDIS_URL=redis://127.0.0.1:6379
# Required at runtime only when platform_ai_configs.isEnabled is true for that provider
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

#--------------------------------------------------------------------
# Platform Razorpay billing
# Webhook URL: https://<host>/api/v1/webhooks/billing/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

#--------------------------------------------------------------------
# Media storage (private S3-compatible + public base for WhatsApp links)
#
# AWS S3 + CloudFront:
#   leave S3_ENDPOINT unset; MEDIA_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net
#
# Contabo Object Storage (S3 API):
#   S3_ENDPOINT=https://eu2.contabostorage.com   # or usc1 / sin1
#   S3_FORCE_PATH_STYLE=true
#   AWS_REGION=default                           # Contabo accepts a placeholder region
#   MEDIA_PUBLIC_BASE_URL=https://eu2.contabostorage.com/<tenantId>:<bucket>
#   OUTBOUND_MEDIA_ALLOWED_HOSTS=eu2.contabostorage.com
#--------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# S3_ENDPOINT=https://eu2.contabostorage.com
# S3_FORCE_PATH_STYLE=true
DRIVE_DISK=s3
# MEDIA_STORAGE_NAMESPACE_V2=true
MEDIA_PUBLIC_BASE_URL=
OUTBOUND_MEDIA_ALLOWED_HOSTS=
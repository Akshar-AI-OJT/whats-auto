NODE_ENV=test
PORT=3333
HOST=localhost
LOG_LEVEL=error

APP_KEY=test-app-key-at-least-32-characters
APP_URL=http://localhost:3333

SESSION_DRIVER=memory
CORS_ORIGIN=http://localhost:3000

BETTER_AUTH_SECRET=test-better-auth-secret-32-characters
BETTER_AUTH_URL=http://localhost:3333

JWT_ISSUER=http://localhost:3333
JWT_AUDIENCE=whats-auto-api-test
JWT_ACCESS_TOKEN_TTL=15m

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Postgres: inherit PG_* from `.env` (staging). Do not override here unless you need an isolated test DB.
# Example local Docker test DB:
# PG_HOST=localhost
# PG_PORT=5433
# PG_USER=postgres
# PG_PASSWORD=test
# PG_DB_NAME=whats_auto_test
# PG_SSL=false

MAIL_MAILER=smtp
MAIL_FROM_NAME=WhatsAuto Test
MAIL_FROM_ADDRESS=test@whatsauto.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test

WHATSAPP_VERIFY_TOKEN=test-verify-token
META_APP_SECRET=test-meta-app-secret
META_EMBEDDED_SIGNUP_CONFIG_ID=test-config-id
META_APP_ID=test-app-id
META_GRAPH_API_VERSION=v26.0

JOB_QUEUE_DRIVER=null

RAZORPAY_KEY_ID=test_rzp_key
RAZORPAY_KEY_SECRET=test_rzp_secret
RAZORPAY_WEBHOOK_SECRET=test_rzp_webhook_secret

# Local Drive + ObjectStorage for tests (media tests bind FakeObjectStorage in-process).
# Contact-import CSVs use Drive; keep driver=fs so allocate/put/get work without S3.
OBJECT_STORAGE_DRIVER=fs
DRIVE_DISK=fs
MEDIA_LOCAL_ROOT=
MEDIA_PUBLIC_BASE_URL=https://media.test.local
OUTBOUND_MEDIA_ALLOWED_HOSTS=media.test.local

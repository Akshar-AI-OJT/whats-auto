{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node build/bin/server.js",
    "build": "node ace build",
    "postbuild": "node -e \"const fs = require('fs'); if (fs.existsSync('.env')) fs.copyFileSync('.env', 'build/.env')\"",
    "dev": "node ace serve --watch",
    "worker": "node --import=@poppinss/ts-exec bin/worker.ts",
    "test": "node ace test",
    "db:seed:demo": "node ace db:seed --files=./database/seeders/demo_seeder.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#services/job_queue/*": "./app/services/job_queue/*.js",
    "#services/job_queue/contracts/*": "./app/services/job_queue/contracts/*.js",
    "#services/job_queue/drivers/*": "./app/services/job_queue/drivers/*.js",
    "#services/job_queue/handlers/*": "./app/services/job_queue/handlers/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#lib/*": "./lib/*.js",
    "#lib/redis/*": "./lib/redis/*.js",
    "#lib/meta_whatsapp/*": "./lib/meta_whatsapp/*.js",
    "#lib/razorpay/*": "./lib/razorpay/*.js",
    "#services/billing/*": "./app/services/billing/*.js",
    "#types/*": "./types/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.9.1",
    "eslint": "^9.39.4",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@types/pg": "^8.20.0",
    "@vinejs/vine": "^4.4.0",
    "adonis-autoswagger": "^3.73.0",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^6.0.9",
    "csv-parse": "^7.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.4",
    "libphonenumber-js": "^1.13.11",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}

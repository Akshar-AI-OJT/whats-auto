# Contabo reverse proxy — cross-origin (app + api).
#
# Install Caddy on the VPS host (not in compose). DNS:
#   ottobot.codecolonies.com → VPS
#   api.ottobot.codecolonies.com → VPS
#
# Media: host dir /var/www/whats-auto is bind-mounted into api+worker
# and served publicly at https://api.yourdomain.com/media/<storageKey>
# (WhatsApp GETs never hit Node).
#
# Frontend build: NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Backend: CORS_ORIGIN=https://app.yourdomain.com
#          BETTER_AUTH_URL / APP_URL / JWT_ISSUER=https://api.yourdomain.com
#          MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/media

ottobot.codecolonies.com {
	reverse_proxy 127.0.0.1:3000
}

api.ottobot.codecolonies.com {
	# Raise body size for local-disk media PUTs (documents up to 100 MiB)
	request_body {
		max_size 110MB
	}

	handle_path /media/* {
		root * /var/www/whats-auto
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3333
	}
}

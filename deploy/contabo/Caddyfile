# Contabo reverse proxy — cross-origin (app. + api.)
#
# Install Caddy on the VPS host (not in compose). DNS:
#   app.yourdomain.com → VPS
#   api.yourdomain.com → VPS
#
# Frontend build must set NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Backend: CORS_ORIGIN=https://app.yourdomain.com
#          BETTER_AUTH_URL / APP_URL / JWT_ISSUER=https://api.yourdomain.com

app.yourdomain.com {
	reverse_proxy 127.0.0.1:3000
}

api.yourdomain.com {
	reverse_proxy 127.0.0.1:3333
}

# Whats Auto routes only. Imported by ServeOS Caddy — do not run a second Caddy.
#
# Host file: /var/www/whats-auto/deploy/contabo/Caddyfile
# ServeOS Caddy container (serveos-production-proxy) must bind-mount this file
# at the SAME path (host paths are not visible inside Docker otherwise).
# See deploy/contabo/serveos-caddy.snippet
#
# Reverse-proxy targets are Compose service names on serveos-production_public:
#   frontend → 3200
#   api      → 3201
#
# Media files are served by this Caddy (file_server), not Node. Mount:
#   /var/www/whats-auto/apps/backend/media  (read-only) into serveos-production-proxy

ottobot.codecolonies.com {
	reverse_proxy frontend:3200
}

api.ottobot.codecolonies.com {
	request_body {
		max_size 110MB
	}

	handle_path /media/* {
		root * /var/www/whats-auto/apps/backend/media
		file_server
	}

	handle /api/v1/inbox/events {
		reverse_proxy api:3201 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy api:3201
	}
}

# Contabo reverse proxy — cross-origin (app + api).
#
# Install Caddy on the VPS host (not in compose). DNS:
#   ottobot.codecolonies.com → VPS
#   api.ottobot.codecolonies.com → VPS
#
# Frontend build must set NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com
# Backend: CORS_ORIGIN=https://ottobot.codecolonies.com
#          BETTER_AUTH_URL / APP_URL / JWT_ISSUER=https://api.ottobot.codecolonies.com

ottobot.codecolonies.com {
	reverse_proxy 127.0.0.1:3200
}

api.ottobot.codecolonies.com {
	reverse_proxy 127.0.0.1:3201
}

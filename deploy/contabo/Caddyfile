# Contabo reverse proxy — cross-origin (app + api).
#
# Install Caddy on the VPS host (not in compose). DNS:
#   ottobot.codecolonies.com → VPS
#   api.ottobot.codecolonies.com → VPS
#
# Media: host dir /var/www/whats-auto/media is bind-mounted into api+worker
# and served publicly at https://api.ottobot.codecolonies.com/media/<storageKey>
# (WhatsApp GETs never hit Node).
#
# Frontend: 127.0.0.1:3200   API: 127.0.0.1:3201

ottobot.codecolonies.com {
	reverse_proxy 127.0.0.1:3200
}

api.ottobot.codecolonies.com {
	# Raise body size for local-disk media PUTs (documents up to 100 MiB)
	request_body {
		max_size 110MB
	}

	handle_path /media/* {
		root * /var/www/whats-auto/media
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3201
	}
}

# Copy to deploy/contabo/.env and fill in secrets.
# docker compose loads this file for api/worker; frontend build args use the same file.

#--------------------------------------------------------------------
# Host ports (Caddy/Nginx on the VPS should proxy to these)
#--------------------------------------------------------------------
FRONTEND_HOST_PORT=3200
API_HOST_PORT=3201

#--------------------------------------------------------------------
# Frontend (baked at image build — rebuild frontend after changing)
# Cross-origin Contabo (required):
#   NEXT_PUBLIC_APP_URL=https://ottobot.codecolonies.com
#   NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com
#--------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ottobot.codecolonies.com
NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com

#--------------------------------------------------------------------
# Backend core
#--------------------------------------------------------------------
NODE_ENV=production
TZ=UTC
PORT=3201
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=                    # openssl rand -base64 32
APP_URL=https://api.ottobot.codecolonies.com
SESSION_DRIVER=cookie

CORS_ORIGIN=https://ottobot.codecolonies.com
BETTER_AUTH_SECRET=         # openssl rand -base64 32 (≥32 chars)
BETTER_AUTH_URL=https://api.ottobot.codecolonies.com
JWT_ISSUER=https://api.ottobot.codecolonies.com
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Postgres — bundled compose service (PG_HOST overridden to `postgres` in compose)
# PG_USER / PG_PASSWORD / PG_DB_NAME are used by the postgres container.
# For external Postgres by IP instead, see deploy/contabo/DEPLOY_CONFIG.md.
# After first deploy: bash deploy/contabo/migrate.sh
#--------------------------------------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_USER=whatsauto
PG_PASSWORD=
PG_DB_NAME=whatsauto
PG_SSL=false

#--------------------------------------------------------------------
# Redis / jobs (compose service)
#--------------------------------------------------------------------
REDIS_URL=redis://redis:6379
JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_BULLMQ_PREFIX=wa:bullmq

#--------------------------------------------------------------------
# Media — local disk on Contabo VPS (default)
# Host path bind-mounted into api + worker. Caddy serves /media/*.
# sudo mkdir -p /var/lib/whats-auto/media && sudo chown 1001:1001 /var/lib/whats-auto/media
#--------------------------------------------------------------------
OBJECT_STORAGE_DRIVER=fs
DRIVE_DISK=fs
MEDIA_HOST_PATH=/var/lib/whats-auto/media
MEDIA_LOCAL_ROOT=/var/lib/whats-auto/media
MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/media
OUTBOUND_MEDIA_ALLOWED_HOSTS=api.yourdomain.com
# S3_* not required when OBJECT_STORAGE_DRIVER=fs

#--------------------------------------------------------------------
# Meta / billing / AI / mail (same as Railway)
# Webhooks must hit the public API origin:
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/whatsapp
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/billing/razorpay
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=v21.0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=noreply@ottobot.codecolonies.com
#--------------------------------------------------------------------
# Mail (Adonis — MAIL_MAILER=brevo|smtp)
#--------------------------------------------------------------------
MAIL_MAILER=brevo
MAIL_FROM_NAME=WhatsAuto
MAIL_FROM_ADDRESS=noreply@yourdomain.com
BREVO_API=

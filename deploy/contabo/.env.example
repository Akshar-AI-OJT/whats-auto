# Copy to deploy/contabo/.env and fill in secrets.
# docker compose loads this file for api/worker; build args use the same file.

#--------------------------------------------------------------------
# Host ports (Caddy/Nginx on the VPS should proxy to these)
#--------------------------------------------------------------------
FRONTEND_HOST_PORT=3200
API_HOST_PORT=3201

#--------------------------------------------------------------------
# Frontend (baked at image build — rebuild frontend after changing)
# Cross-origin Contabo (required):
#   NEXT_PUBLIC_APP_URL=https://ottobot.codecolonies.com
#   NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com
#--------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ottobot.codecolonies.com
NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com

#--------------------------------------------------------------------
# Backend core
#--------------------------------------------------------------------
NODE_ENV=production
TZ=UTC
PORT=3201
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=                    # openssl rand -base64 32
APP_URL=https://api.ottobot.codecolonies.com
SESSION_DRIVER=cookie

CORS_ORIGIN=https://ottobot.codecolonies.com
BETTER_AUTH_SECRET=         # openssl rand -base64 32 (≥32 chars)
BETTER_AUTH_URL=https://api.ottobot.codecolonies.com
JWT_ISSUER=https://api.ottobot.codecolonies.com
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Postgres (compose service `postgres` — do not use an external IP)
# First `up` loads whatsapp_schema.sql (empty volume only).
#--------------------------------------------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DB_NAME=whatsapp_production
PG_SSL=false

#--------------------------------------------------------------------
# Redis / jobs
#--------------------------------------------------------------------
REDIS_URL=redis://redis:6379
JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_BULLMQ_PREFIX=wa:bullmq

#--------------------------------------------------------------------
# Contabo Object Storage (S3-compatible)
# Panel → Object Storage → Security & Access for keys.
# Region endpoints: eu2 | usc1 | sin1  (https://<region>.contabostorage.com)
#--------------------------------------------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=default
S3_BUCKET=
S3_ENDPOINT=https://eu2.contabostorage.com
S3_FORCE_PATH_STYLE=true
DRIVE_DISK=s3
# Public fetch base WhatsApp uses (no trailing slash). Typical Contabo form:
#   https://eu2.contabostorage.com/<tenantId>:<bucket>
MEDIA_PUBLIC_BASE_URL=https://eu2.contabostorage.com/TENANT_ID:BUCKET
OUTBOUND_MEDIA_ALLOWED_HOSTS=eu2.contabostorage.com

#--------------------------------------------------------------------
# Meta / billing / AI / mail (same as Railway)
# Webhooks must hit the public API origin:
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/whatsapp
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/billing/razorpay
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=v21.0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=noreply@ottobot.codecolonies.com

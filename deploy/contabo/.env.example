# Copy to deploy/contabo/.env. Compose loads this for backend/worker;
# frontend NEXT_PUBLIC_* are baked at image build (rebuild frontend after changing them).

#--------------------------------------------------------------------
# Public URLs
#--------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ottobot.codecolonies.com
NEXT_PUBLIC_API_URL=https://api.ottobot.codecolonies.com

#--------------------------------------------------------------------
# Backend
#--------------------------------------------------------------------
NODE_ENV=production
TZ=UTC
PORT=3201
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=                    # openssl rand -base64 32
APP_URL=https://api.ottobot.codecolonies.com
SESSION_DRIVER=cookie

CORS_ORIGIN=https://ottobot.codecolonies.com
BETTER_AUTH_SECRET=         # openssl rand -base64 32 (≥32 chars)
BETTER_AUTH_URL=https://api.ottobot.codecolonies.com
JWT_ISSUER=https://api.ottobot.codecolonies.com
JWT_AUDIENCE=whats-auto-api
JWT_ACCESS_TOKEN_TTL=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#--------------------------------------------------------------------
# Postgres (compose service whats-auto-postgres)
# After first deploy: bash deploy/contabo/migrate.sh
# SUPERADMIN_EMAIL — first platform admin; then Forgot Password (mail must work).
#--------------------------------------------------------------------
SUPERADMIN_EMAIL=you@yourdomain.com
PG_HOST=whats-auto-postgres
PG_PORT=5432
PG_USER=whatsauto
PG_PASSWORD=                    # openssl rand -base64 24
PG_DB_NAME=whatsauto
PG_SSL=false

#--------------------------------------------------------------------
# Redis / jobs
#--------------------------------------------------------------------
REDIS_URL=redis://whats-auto-redis:6379
JOB_QUEUE_DRIVER=bullmq
JOB_QUEUE_BULLMQ_PREFIX=wa:bullmq

#--------------------------------------------------------------------
# Media (local disk). Caddy serves /media from this path.
#   sudo mkdir -p /var/www/whats-auto/apps/backend/media && sudo chown 1001:1001 /var/www/whats-auto/apps/backend/media
#--------------------------------------------------------------------
OBJECT_STORAGE_DRIVER=fs
DRIVE_DISK=fs
MEDIA_HOST_PATH=/var/www/whats-auto/apps/backend/media
MEDIA_LOCAL_ROOT=/var/www/whats-auto/apps/backend/media
MEDIA_PUBLIC_BASE_URL=https://api.ottobot.codecolonies.com/media
OUTBOUND_MEDIA_ALLOWED_HOSTS=api.ottobot.codecolonies.com

#--------------------------------------------------------------------
# Meta / billing / AI
# Webhooks:
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/whatsapp
#   https://api.ottobot.codecolonies.com/api/v1/webhooks/billing/razorpay
#--------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_ID=
META_GRAPH_API_VERSION=v21.0

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

#--------------------------------------------------------------------
# Mail (MAIL_MAILER=brevo|smtp)
#--------------------------------------------------------------------
MAIL_MAILER=brevo
MAIL_FROM_NAME=WhatsAuto
MAIL_FROM_ADDRESS=noreply@ottobot.codecolonies.com
BREVO_API=
